# Orion NanoBrain Configuration Template
# Copy this file to .env and customize for your environment.
# Values here act as defaults; actual OS environment variables take precedence.

# --- Dual-Engine Second Worker Mode ---
# Controls execution routing priority for Goldfish Swarm Audits & Pre-Drafts:
#   local_first : Use Local Ollama if online, fallback to Remote API Worker (OpenCode Go)
#   api_first   : Use Remote API Worker (parallel max_workers=3), fallback to Local Ollama
#   local_only  : Strictly disallow remote API worker calls
ORION_WORKER_MODE=local_first
ORION_MAX_PARALLEL=3

# --- Pillar 3A: Ollama / Local LLM Endpoint ---
# The base URL for the local Ollama API. The system uses a dual-stack
# fallback strategy (IPv4 -> IPv6 -> localhost) so this value is only
# used as the FIRST candidate.
ORION_LLM_URL=http://127.0.0.1:11434/api/generate
ORION_OLLAMA_ENABLED=true
# OLLAMA_MODEL=qwen2.5-coder:1.5b
# ORION_OLLAMA_MODEL_FAST=qwen2.5-coder:1.5b
# ORION_OLLAMA_MODEL_CODE=qwen2.5-coder:7b
# ORION_OLLAMA_MODEL_HEAVY=deepseek-r1:14b

# --- Pillar 3B: Remote API Second Worker (OpenCode Go / OpenAI-Compatible) ---
# Set ORION_API_KEY to enable 0%-Primary-IDE-Quota multi-model subagent routing.
# OpenCode Go endpoints:
#   https://opencode.ai/zen/go/v1                  (Legacy / Zen-Go unified proxy)
#   https://opencode.ai/inference/go/openai/v1     (OpenClaw / OpenCode Go v2 native endpoint)
ORION_API_WORKER_ENABLED=true
ORION_API_BASE_URL=https://opencode.ai/zen/go/v1
# ORION_API_KEY=your_opencode_go_api_key_here

# --- Multi-Model Harness Slots (Budget & Capability Stratification) ---
# Maps specialized worker roles/lenses to distinct model allowances:
ORION_API_MODEL_NANO=glm-4.5-air
ORION_API_MODEL_FAST=qwen3-coder-flash
ORION_API_MODEL_SMART=deepseek-v4-pro
ORION_API_MODEL_COUNCIL=kimi-k3

# --- Multi-Provider Presets & Per-Slot Combo Configurations ---
# Supported providers: opencode, chutes, 9router, openrouter, groq, deepseek, cerebras, together, fireworks, openai
# ORION_API_PROVIDER=chutes

# Recipe A: Single Provider (e.g. Chutes.ai, OpenRouter, Groq, OpenCode Go)
# ORION_API_BASE_URL=https://llm.chutes.ai/v1
# CHUTES_API_KEY=cpk_your_chutes_api_key_here
# ORION_API_MODEL_FAST=Qwen/Qwen2.5-Coder-32B-Instruct
# ORION_API_MODEL_SMART=deepseek-ai/DeepSeek-V3

# Recipe B: 9Router Local / Cloud Combo Proxy (http://127.0.0.1:20128/v1)
# ORION_API_BASE_URL=http://127.0.0.1:20128/v1
# NINEROUTER_API_KEY=local-router

# Recipe C: Per-Slot Combo Routing (Different Providers for Fast, Smart, Council)
# ORION_API_BASE_URL_FAST=https://api.groq.com/openai/v1
# ORION_API_KEY_FAST=gsk_your_groq_key
# ORION_API_BASE_URL_SMART=https://llm.chutes.ai/v1
# ORION_API_KEY_SMART=cpk_your_chutes_key
# ORION_API_BASE_URL_COUNCIL=https://openrouter.ai/api/v1
# ORION_API_KEY_COUNCIL=sk-or-v1-your_openrouter_key

# --- 10-Role Sovereign Autonomous Harness Defaults ---
# Default role for 'orion worker auto' when intent is ambiguous:
ORION_DEFAULT_AUTO_ROLE=oracle
