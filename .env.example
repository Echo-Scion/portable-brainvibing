# Orion NanoBrain Configuration Template
# Copy this file to .env and customize for your environment.
# Values here act as defaults; actual OS environment variables take precedence.

# --- Ollama / Local LLM Endpoint ---
# The base URL for the local Ollama API. The system uses a dual-stack
# fallback strategy (IPv4 -> IPv6 -> localhost) so this value is only
# used as the FIRST candidate. If it fails, the system automatically
# tries alternative bindings before giving up.
#
# Common values:
#   http://127.0.0.1:11434/api/generate   (IPv4 loopback - fastest on Windows)
#   http://localhost:11434/api/generate    (OS-resolved - may hit IPv6 on Windows)
#   http://[::1]:11434/api/generate        (IPv6 loopback - Linux default)
#   http://192.168.x.x:11434/api/generate (LAN remote Ollama)
#
ORION_LLM_URL=http://127.0.0.1:11434/api/generate

# --- Optional: Force a specific Ollama model ---
# Uncomment to override dynamic model selection from host introspection.
# OLLAMA_MODEL=qwen2.5-coder:1.5b
