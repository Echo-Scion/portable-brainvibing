    {
      "id": "AST_DANGEROUS_IMPORT",
      "path": "*.agents/scripts/core/capabilities.py",
      "reason": "Authorized Windows kernel32 memory inspection via ctypes for conservative hardware tiering"
    },
    {
      "id": "AST_DANGEROUS_IMPORT",
      "path": "*.agents/hooks/pre-agent-wake.py",
      "reason": "Authorized Windows kernel32 PeekNamedPipe non-blocking stdin inspection"
    },
    {
      "id": "AST_DYNAMIC_IMPORT",
      "path": "*.agents/scripts/core/__init__.py",
      "reason": "Authorized PEP 562 lazy loading for canonical core modules"
    },
    {
      "id": "AST_NETWORK_SOCKET",
      "path": "*.agents/scripts/commands/brain.py",
      "reason": "Authorized internal Ollama localhost API call"
    },
    {
      "id": "AST_NETWORK_SOCKET",
      "path": "*.agents/scripts/commands/verify_agents.py",
      "reason": "Authorized Ollama liveness check on 127.0.0.1"
    },
    {
      "id": "REMOTE_BOOTSTRAP",
      "path": "*PREREQUISITES.md",
      "reason": "Official upstream CLI install instructions for rustup, ollama, bun"
    },
    {
      "id": "TOOL_POISONING",
      "path": "*.antigravity-plugin*",
      "reason": "Plugin manifest description metadata"
    },
    {
      "id": "ast-grep:no-empty-catch-py",
      "path": "*.agents/*",
      "reason": "Authorized framework fallbacks, reconfigure wrappers, and optional dependency imports in .agents"
    },
    {
      "id": "AST_SILENT_EXCEPTION_SWALLOW",
      "path": "*.agents/*",
      "reason": "Authorized framework fallbacks, reconfigure wrappers, and optional dependency imports in .agents"
    }
  ],
